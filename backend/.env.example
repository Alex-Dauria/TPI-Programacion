# Copiar este archivo como .env (en la carpeta backend/) y ajustar los valores.

# PostgreSQL 15+ (crear antes la base: CREATE DATABASE foodstore_db;)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Alternativa para desarrollo local sin instalar PostgreSQL:
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT: mínimo 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
# Expiración del token y de la cookie (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origen del frontend permitido en CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
